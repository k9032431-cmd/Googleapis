# ==========================================================================
#  PasarGuard -> Google Drive subscription sync — конфигурация
#  Скопируй в .env  (cp .env.example .env)  и заполни значения.
# ==========================================================================

# --------------------------------------------------------------------------
#  PasarGuard (панель)
# --------------------------------------------------------------------------
# Базовый адрес панели. Сервис стоит на том же сервере, поэтому обращается
# к панели по localhost — блокировка публичного домена панели не мешает.
PANEL_BASE_URL=http://127.0.0.1:8000

# Логин/пароль администратора панели (sudo-админ, который видит нужных юзеров).
PANEL_ADMIN_USERNAME=
PANEL_ADMIN_PASSWORD=

# Проверять TLS-сертификат панели. Для http://127.0.0.1 значение не важно.
PANEL_VERIFY_TLS=true

# --------------------------------------------------------------------------
#  Что забирать из панели
# --------------------------------------------------------------------------
# User-Agent, под которым запрашивается подписка. Определяет формат:
#   v2rayNG/...  -> базовая base64-подписка (универсально)
#   clash / sing-box клиенты вернут свой формат.
SUB_USER_AGENT=v2rayNG/1.8.5

# Явный формат подписки (добавляется в путь: /sub/<token>/<client_type>).
# Оставь пустым, чтобы формат выбирался по User-Agent.
# Возможные значения зависят от версии панели (например: v2ray, clash, sing-box).
SUB_CLIENT_TYPE=

# Кого синхронизировать: список username через запятую. Пусто = всех.
TARGET_USERS=

# Синхронизировать только активных пользователей (active/on_hold).
ONLY_ACTIVE_USERS=true

# Писать googleapis-ссылку в заметку (note) пользователя в панели — тогда
# ссылку видно прямо в панели при открытии юзера. Заметки, написанные вручную,
# не затираются (меняются только пустые или те, где уже стоит googleapis-ссылка).
PANEL_WRITE_NOTE=false

# --------------------------------------------------------------------------
#  Google Drive — ЗАПИСЬ
# --------------------------------------------------------------------------
# Режим авторизации записи:
#   oauth           — от имени ЛИЧНОГО Google-аккаунта. Работает на обычном
#                     бесплатном Gmail (15 ГБ). РЕКОМЕНДУЕТСЯ.
#   service_account — через сервис-аккаунт. Требует Shared Drive (платный
#                     Google Workspace), иначе ошибка storageQuotaExceeded.
# Если оставить пустым — выбирается автоматически: oauth, когда задан
# GOOGLE_OAUTH_REFRESH_TOKEN, иначе service_account.
DRIVE_AUTH_MODE=oauth

# --- режим oauth (личный аккаунт) ---
# Как получить эти три значения — см. README (через Google OAuth Playground,
# всё в браузере, без установки чего-либо на ПК).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- режим service_account (только с Shared Drive / Workspace) ---
# Путь к JSON-ключу сервис-аккаунта.
GOOGLE_SERVICE_ACCOUNT_FILE=/opt/googleapis-bot/service_account.json

# ID папки на Google Drive, куда складывать файлы подписок.
# В режиме oauth — любая твоя папка (ты её владелец). ID из адреса папки:
#   drive.google.com/drive/folders/<ЭТОТ_ID>
DRIVE_FOLDER_ID=

# Шаблон имени файла на Drive. {username} подставляется.
FILE_NAME_TEMPLATE={username}.txt

# --------------------------------------------------------------------------
#  Google Drive — ЧТЕНИЕ (API-ключ)
# --------------------------------------------------------------------------
# API-ключ Google (Google Cloud -> Credentials -> API key). Подставляется в
# ссылку, которую скачивает клиент:
#   https://www.googleapis.com/drive/v3/files/<id>?key=<GOOGLE_API_KEY>&alt=media
# В том же проекте должен быть включён Google Drive API.
GOOGLE_API_KEY=

# --------------------------------------------------------------------------
#  Поведение / состояние
# --------------------------------------------------------------------------
# Период синхронизации в секундах. 0 = один проход и выход (для systemd timer).
# >0 = крутиться в цикле (для systemd service). Например 300 = каждые 5 минут.
SYNC_INTERVAL=300

# Куда писать состояние (сопоставление username -> file_id) и итоговые ссылки.
STATE_DIR=/var/lib/pasarguard-drive-sync
# STATE_FILE=/var/lib/pasarguard-drive-sync/state.json
# LINKS_FILE=/var/lib/pasarguard-drive-sync/links.json

# ==========================================================================
#  (Необязательно) Телеграм-бот bot.py — ручная выдача googleapis-ссылки по
#  ID файла на Drive. Нужен только если включаешь бот-сервис.
# ==========================================================================
# BOT_TOKEN=
# ALLOWED_USERS=
# VERIFY_LINKS=true
