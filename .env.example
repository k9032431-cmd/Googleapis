# ==========================================================================
#  Googleapis Drive Link Bot — конфигурация
#  Скопируй этот файл в .env  (cp .env.example .env)  и заполни значения.
# ==========================================================================

# --- Telegram --------------------------------------------------------------
# Токен бота. Получить у @BotFather: /newbot -> тебе выдадут строку вида
# 123456789:AAE...xyz. Вставь её сюда (без кавычек).
BOT_TOKEN=

# --- Google API ------------------------------------------------------------
# API-ключ Google (тот самый "key" в ссылке googleapis).
# Создаётся в Google Cloud Console:
#   console.cloud.google.com -> APIs & Services -> Credentials -> Create API key
# В том же проекте нужно включить "Google Drive API".
# Пример ключа: AIzaSyBAzUBu6jC3DnuJX34ZGUPKT6rfDiueTQQ
GOOGLE_API_KEY=

# --- Доступ (необязательно) ------------------------------------------------
# Список Telegram user id, которым разрешено пользоваться ботом,
# через запятую. Свой id можно узнать у @userinfobot.
# Если оставить пустым — бот отвечает всем (НЕ рекомендуется, ключ в ссылке
# виден каждому, кто пользуется ботом).
# Пример: ALLOWED_USERS=11111111,22222222
ALLOWED_USERS=

# --- Поведение (необязательно) --------------------------------------------
# Проверять ли ссылку перед выдачей (запрос метаданных файла к Google).
# true  — бот убедится, что файл доступен по ключу, и покажет имя/размер.
# false — бот просто сформирует ссылку, ничего не проверяя (быстрее).
VERIFY_LINKS=true
